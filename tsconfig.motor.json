{
  // Motor DOM'suz ve Node'suz derlenir: document, window, fetch ya da process kullanırsa
  // tür denetimi kırılır. Görsel dilin saf hesapları (src/gorsel/cizim.ts, karo.ts, kilik.ts) ve
  // oyunun mantığı (src/oyun) da burada, motorla birlikte denetlenir. Testler
  // tsconfig.app.json ile denetlenir.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/motor", "src/gorsel/cizim.ts", "src/gorsel/karo.ts", "src/gorsel/kilik.ts", "src/oyun"],
  "exclude": ["src/motor/**/*.test.ts", "src/oyun/**/*.test.ts"]
}
